# ==============================================================================
# Sistema de Almoxarifado Industrial — Variáveis de Ambiente
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Públicas do Firebase Client (SDK Web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rhowert-a57af
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rhowert-a57af.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rhowert-a57af.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 2. Emuladores Locais (Desenvolvimento Offline sem Custos)
# ------------------------------------------------------------------------------
# Para usar os emuladores locais do Firebase Suite (firebase emulators:start):
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (Servidor / Rotas de API - Protegidas)
# ------------------------------------------------------------------------------
# Modo A: Credenciais Diretas de Conta de Serviço (JSON baixado do Firebase Console)
FIREBASE_ADMIN_PROJECT_ID=rhowert-a57af
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Modo B: Caminho para Arquivo de Credenciais do Google Cloud ADC (Opcional)
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/absoluto/service-account.json

# ------------------------------------------------------------------------------
# 4. Links de Convite e Recuperação de Acesso
# ------------------------------------------------------------------------------
# A senha é definida na página de ação hospedada pelo Firebase; depois disso o
# usuário é redirecionado para esta URL. Deve apontar para a tela de login e o
# domínio precisa estar em Authentication > Settings > Authorized domains.
# Se omitida, usa VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL/NEXT_PUBLIC_APP_URL + /login.
FIREBASE_AUTH_CONTINUE_URL=https://seu-dominio.example.com/login

# URL pública da aplicação (usada como fallback para montar o link acima)
# NEXT_PUBLIC_APP_URL=https://seu-dominio.example.com

# Webhook opcional para envio dos e-mails de convite e redefinição de senha.
# Recebe POST JSON { type: 'user-invite' | 'password-reset', recipientEmail, recipientName, resetLink }.
# Sem ele, o link é exibido na tela de usuários para envio manual.
# USER_EMAIL_DELIVERY_URL=https://seu-servico-de-email.example.com/hooks/almoxarifado

# ------------------------------------------------------------------------------
# 5. Pedidos de Venda
# ------------------------------------------------------------------------------
# Setores de destino extras, somados ao catálogo padrão (Produção, Expedição,
# Oficina, Montagem e Terceiros / Cliente Externo). Separe por vírgula.
# NEXT_PUBLIC_SETORES_DESTINO_EXTRAS=Pintura, Usinagem

# ------------------------------------------------------------------------------
# 6. Monitoramento
# ------------------------------------------------------------------------------
# Webhook opcional que recebe um aviso a cada erro interno (500) da API, com o
# código mostrado ao usuário. Aceita Slack, Discord ou Google Chat (incoming webhook).
# ERROR_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
