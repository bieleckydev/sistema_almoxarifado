# ==============================================================================
# Sistema de Almoxarifado Industrial — Variáveis de Ambiente
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Públicas do Firebase Client (SDK Web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rhowert-a57af
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rhowert-a57af.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rhowert-a57af.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 2. Emuladores Locais (Desenvolvimento Offline sem Custos)
# ------------------------------------------------------------------------------
# Para usar os emuladores locais do Firebase Suite (firebase emulators:start):
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (Servidor / Rotas de API - Protegidas)
# ------------------------------------------------------------------------------
# Modo A: Credenciais Diretas de Conta de Serviço (JSON baixado do Firebase Console)
FIREBASE_ADMIN_PROJECT_ID=rhowert-a57af
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Modo B: Caminho para Arquivo de Credenciais do Google Cloud ADC (Opcional)
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/absoluto/service-account.json

# ------------------------------------------------------------------------------
# 4. Links de Convite e Recuperação de Acesso
# ------------------------------------------------------------------------------
FIREBASE_AUTH_CONTINUE_URL=https://seu-dominio.example.com/definir-senha
